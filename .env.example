# Shared by both apps (apps/booking and apps/admin load this file from the
# repo root). Copy to .env.local.

# Supabase project settings: Dashboard → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret key (sb_secret_... or legacy service_role). Bypasses RLS:
# never prefix with NEXT_PUBLIC_ and never import into client code.
# Required by the booking app, which serves signed-out customers.
SUPABASE_SECRET_KEY=your-secret-key

# Stripe Connect deposits (info/stripe.md). Test-mode keys while building:
# Dashboard → Developers → API keys. Server-only: never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint listening to events on CONNECTED
# accounts, pointing at <booking app>/api/webhooks/stripe. Locally, the secret
# `stripe listen --forward-connect-to localhost:3000/api/webhooks/stripe` prints.
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret of the Accounts v2 event destination (thin events:
# v2.core.account[requirements].updated and the merchant capability events),
# pointing at <booking app>/api/webhooks/stripe-accounts.
STRIPE_ACCOUNTS_WEBHOOK_SECRET=whsec_...
# Claude API key (console.anthropic.com → API keys), used by the booking app to
# work out a car's condition from the customer's photos
# (packages/core/src/booking/assess.ts). Server-only. Without it, photos aren't
# checked: jobs are booked with no condition uplift and marked for the owner
# to check the car.
ANTHROPIC_API_KEY=

# Self-serve signup (/onboarding on the admin app): what a business pays YOU.
# Dashboard → Product catalogue → add a product with a recurring monthly price,
# then paste its price id (price_...). Test mode while building.
STRIPE_SUBSCRIPTION_PRICE_ID=price_...
# Publishable key (pk_test_...) of the SAME Stripe account as STRIPE_SECRET_KEY:
# Dashboard → Developers → API keys. Public by design. Signup's last stage shows
# Stripe's card form on the page itself, which needs it; sign-up stays closed
# until it's set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: id (pmc_...) of a payment method configuration that offers card only,
# for the subscription's card form. Create one under Dashboard → Settings →
# Payment methods (turn off everything but Card, including Link) and copy its id.
# Without it the account's default configuration is used, which may list
# Klarna, Amazon Pay and others beside the card.
STRIPE_SUBSCRIPTION_PAYMENT_METHOD_CONFIG=
# Signing secret of a webhook endpoint for events on YOUR account (not
# connected accounts), pointing at <admin app>/api/webhooks/stripe-billing.
# Events: checkout.session.completed, customer.subscription.created/updated/deleted.
# Locally, `stripe listen --forward-to localhost:3001/api/webhooks/stripe-billing`
# prints the secret.
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# --- Routing (info/routing.md) -----------------------------------------------
# These replace ADMIN_APP_URL, DOCS_URL and BOOKING_BASE_DOMAIN: every
# address (booking pages, dashboard, docs, Stripe and email links) is built
# from them by packages/core/src/urls.ts.
# How URLs are shaped. "path": every surface on one origin (/, /app, /admin,
# /booking/<slug>), for a *.vercel.app address or localhost:3000. "subdomain":
# domain.com, app.domain.com, admin.domain.com, <slug>.domain.com and verified
# custom domains. Set both to the same value (the build stops if they differ);
# the NEXT_PUBLIC_ one is what the browser sees. To switch, change these, run
# `npm run routing:vercel` (rewrites vercel.json to match), commit and redeploy:
# no code changes. Both builds stop if vercel.json and ROUTING_MODE disagree.
# Defaults: path, localhost:3000.
ROUTING_MODE=path
NEXT_PUBLIC_ROUTING_MODE=path
# The domain the subdomains hang off: domain.com in production, localhost:3000
# in development (browsers send *.localhost to your machine without any DNS).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# The marketing site's full address, which absolute links (emails, Stripe,
# Supabase) are built on: https://bookings-cars.vercel.app in path mode for now,
# https://domain.com in subdomain mode. Must be https in Stripe live mode.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- GDPR / legal ----------------------------------------------------------
# ASCND's own details, shown on the /legal pages and in each business's
# privacy notice. Fill these in before taking real customers.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_ICO_NUMBER=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Signs the one-click unsubscribe links in marketing messages (any long random
# string; changing it invalidates links already sent).
PRIVACY_TOKEN_SECRET=
# The booking app's weekly retention job (/api/jobs/retention) uses the same
# CRON_SECRET as the photo cleanup job.

# --- Email -----------------------------------------------------------------
# Email goes out through Resend (resend.com). Without RESEND_API_KEY,
# development prints each email to the terminal instead of sending it;
# production logs it as failed in email_log. All server-only.
#
# The key needs FULL access, not sending only: businesses add their own
# sending domains from Settings → Notifications, which goes through Resend's
# domains API. Customers' emails come from the business's own verified
# address (email_senders) and aren't sent until it has one.
RESEND_API_KEY=
# The platform's own address, on a domain verified in Resend: alerts to
# businesses that haven't set up their own address, and platform alerts.
# Default onboarding@resend.dev, which only delivers to your own Resend login.
EMAIL_FROM_ADDRESS=
# Where payment problems that match no business go (you, the platform).
PLATFORM_ALERT_EMAIL=
# The booking app's email job (/api/jobs/emails, every 15 minutes: reminders,
# aftercare, review requests, enquiry alerts) uses CRON_SECRET too.
